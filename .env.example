APP_NAME=FinanceTracker
APP_ENV=local
# Run `php artisan key:generate` to fill this in
APP_KEY=
# Production: APP_ENV=production, APP_DEBUG=false and an https APP_URL
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database: pgsql (PostgreSQL 14+) or mysql (MySQL 8+)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=finance_tracker
DB_USERNAME=
DB_PASSWORD=
# Managed databases usually require: DB_SSLMODE=require
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Bank import and currency conversion run on the queue: keep `php artisan queue:work` running
QUEUE_CONNECTION=database

CACHE_STORE=database

# Mail: "log" writes e-mails to storage/logs. For real delivery use MAIL_MAILER=resend
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Stripe (use test-mode keys while developing)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Recurring price for the Pro plan (price_..., not prod_...)
STRIPE_PRICE_ID=

# Demo mode: enables /demo-login and the nightly demo reset. Keep false in production.
DEMO_MODE=false
# DEMO_EMAIL=test@example.com
# DEMO_PASSWORD=test123123

# Sentry (optional). Use a low sample rate in production.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
